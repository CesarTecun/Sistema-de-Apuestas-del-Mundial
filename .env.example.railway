# ============================================================================
# VARIABLES DE ENTORNO PARA RAILWAY
# ============================================================================
# Copia este archivo como .env en Railway o configura estas variables
# en el dashboard de Railway para cada servicio.

# ----------------------------------------------------------------------------
# BACKEND (Django)
# ----------------------------------------------------------------------------

# Database Configuration (PostgreSQL existente - NO desplegar nueva BD en Railway)
DB_NAME=quiniela
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=tu_host_postgresql_existente
DB_PORT=5432
DB_SSLMODE=require

# Django Settings
DEBUG=False
SECRET_KEY=tu-secret-key-seguro-para-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway-specific domains (se configuran automáticamente en Railway)
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_PRIVATE_DOMAIN=

# Frontend URL (para CORS y enlaces enviados por correo)
FRONTEND_URL=https://tu-frontend-url-en-railway.railway.app

# Microservicio Marcador (FastAPI - si está desplegado en otro lugar)
MARCADOR_SERVICE_URL=http://tu-marcador-service-url
MARCADOR_SERVICE_TIMEOUT=30

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_aplicacion_gmail
DEFAULT_FROM_EMAIL=Copa Mundial FIFA 2026 <tu_email@gmail.com>

# ----------------------------------------------------------------------------
# FRONTEND (React)
# ----------------------------------------------------------------------------

# URL del backend desplegado en Railway
REACT_APP_API_URL=https://tu-backend-url-en-railway.railway.app

# ----------------------------------------------------------------------------
# NOTAS IMPORTANTES
# ----------------------------------------------------------------------------
# 1. Las bases de datos (principal y microservicio marcador) NO se despliegan
#    en Railway. Debes usar bases de datos existentes (Neon, Railway PostgreSQL,
#    o tu propio servidor PostgreSQL).
#
# 2. En Railway, debes configurar estas variables en el dashboard:
#    - Para el servicio backend: todas las variables de BACKEND
#    - Para el servicio frontend: REACT_APP_API_URL
#
# 3. Railway proporciona automáticamente RAILWAY_PUBLIC_DOMAIN y
#    RAILWAY_PRIVATE_DOMAIN, pero puedes agregarlas manualmente si es necesario.
#
# 4. Para obtener las URLs de Railway después del despliegue:
#    - Ve al dashboard de Railway
#    - Selecciona tu servicio
#    - Copia la URL del dominio público (ej: https://app-name.railway.app)
